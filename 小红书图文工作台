require('dotenv').config();
const express = require('express');
const cors = require('cors');
const app = express();

const API_KEY = process.env.VOLC_API_KEY;
const API_URL = process.env.VOLC_API_URL || "https://ark.cn-beijing.volces.com/api/v1/images/generations";

app.use(cors());
app.use(express.json({ limit: '10mb' })); // 限制图片base64大小

// AI绘图接口
app.post('/api/generate', async (req, res) => {
  try {
    const { prompt, count, referenceImage } = req.body;
    if (!prompt) return res.status(400).json({ error: "缺少提示词" });

    // 自动追加负面提示词，专门规避AI畸形，适配你的小红书素人写实图
    const negativePrompt = "畸形人脸，扭曲五官，多余手指，残缺肢体，水印，文字，logo，卡通，动漫，3D渲染，模糊，低画质，变形，丑化";
    const payload = {
      model: "doubao-image",
      prompt: prompt,
      negative_prompt: negativePrompt,
      n: count
    };

    // 如果上传参考图，剥离base64前缀
    if(referenceImage){
      const base64Str = referenceImage.replace(/^data:image\/(png|jpeg|jpg);base64,/, "");
      payload.reference_image = base64Str;
      payload.reference_type = "style"; // style：只提取风格，保留你文案主体
    }

    // 请求火山图像API
    const fetchRes = await fetch(API_URL, {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${API_KEY}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });

    const data = await fetchRes.json();
    return res.json(data);
  } catch(err){
    console.error(err);
    return res.status(500).json({error: "服务异常："+err.message});
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, ()=>{
  console.log(`✅ 后端服务启动成功`);
});
